# 本地环境变量模板（LANG-P1-02）
# 用法：cp deploy/.env.example deploy/.env，并把每个空值替换为本地生成的随机值。
# deploy/.env 已被版本控制忽略，真实密钥不得提交。
# 数据库与 Redis 密码会拼进连接地址，必须用链接安全字符：openssl rand -hex 24
# SESSION/CRYPTO 密钥直接透传，可用：openssl rand -base64 48

# 本机访问入口端口（只发布 edge-nginx）
EDGE_HTTP_PORT=8081

# 运维覆盖端口（仅加载 compose.ops.yml 时使用，绑定 127.0.0.1）
NEW_API_ADMIN_PORT=13000

# PostgreSQL（仅内部数据网络使用）
POSTGRES_DB=langapi
POSTGRES_USER=langapi
# 必填：本地 PostgreSQL 密码
POSTGRES_PASSWORD=

# Redis（仅内部数据网络使用）
# 必填：本地 Redis 密码
REDIS_PASSWORD=

# New API 会话与加密密钥（必填，分别独立生成）
SESSION_SECRET=
CRYPTO_SECRET=

# LANG-P1-07 公共模型网关（均为非敏感值，可进版本库）
# 两个虚拟主机名必须非空且不同；本地用 api.localhost 测试域名，正式域名在 P1-12 配置。
PORTAL_SERVER_NAME=localhost
MODEL_API_SERVER_NAME=api.localhost

# 公开 OpenAI Base URL：host 必须与模型站点一致并以 /v1 结束；部署预检会校验。
# 非本地 host 必须使用 https（预检强制），本地联调用 http 即可。
PORTAL_ENABLED_PROTOCOLS=OPENAI
PORTAL_OPENAI_URL=http://api.localhost:8081/v1

# 网关资源边界（默认值与 gateway/Dockerfile 一致，压测后按需调整）
GATEWAY_CLIENT_MAX_BODY=10m
GATEWAY_CONNECT_TIMEOUT=3s
GATEWAY_SEND_TIMEOUT=60s
GATEWAY_READ_TIMEOUT=600s
GATEWAY_RATE_LIMIT=10r/s
GATEWAY_RATE_BURST=20
GATEWAY_CONN_LIMIT=20

# 自有 edge 镜像版本标签（构建参数，缺失时记为 development；生产发布不得使用该占位值）
PROJECT_VERSION=development
GIT_REVISION=development
